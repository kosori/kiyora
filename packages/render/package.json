{
  "name": "@kiyora/render",
  "version": "0.1.0",
  "description": "DOM-free scene compiler and SVG renderer for Kiyora diagrams.",
  "keywords": [
    "diagram",
    "renderer",
    "svg",
    "kiyora"
  ],
  "homepage": "https://github.com/kosori/kiyora",
  "bugs": {
    "url": "https://github.com/kosori/kiyora/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosori/kiyora.git"
  },
  "license": "MIT",
  "author": {
    "name": "Alexis Guzman",
    "url": "https://www.codingcodax.dev"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "default": "./dist/geometry.js"
    },
    "./label": {
      "types": "./dist/label.d.ts",
      "default": "./dist/label.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./shapes": {
      "types": "./dist/shapes.d.ts",
      "default": "./dist/shapes.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "default": "./dist/style.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "default": "./dist/projection.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:published": "bun scripts/verify-published-build.ts"
  },
  "dependencies": {
    "@kiyora/dsl": "*"
  },
  "devDependencies": {
    "@kiyora/typescript": "*",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
