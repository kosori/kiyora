{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // packages/dsl/src is vendored (ADR-0005) and kept as it was from history,
    // so it is neither reformatted nor linted here.
    // `goldens` holds committed SVG artifacts, compared byte for byte; linting
    // or reformatting them would break the comparison.
    "includes": [
      "!!**/public",
      "!!**/node_modules",
      "!!**/.agents",
      "!!packages/dsl/src",
      "!!**/goldens"
    ]
  },
  "formatter": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "performance": {
        "useTopLevelRegex": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noShadow": "off"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "functions": ["clsx", "cva", "cn"]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "useArrowFunction": "error"
      },
      "style": {
        "noNestedTernary": "off",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        }
      }
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single"
    }
  },
  "overrides": [
    {
      // A package's entry is its declared public surface, not an accidental barrel.
      "includes": ["packages/*/src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ],
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ]
}
